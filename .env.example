OLLAMA_URL=http://localhost:11434
# Use quantum-tutor after creating Modelfile.tutor; fall back to granite3.2:8b.
OLLAMA_MODEL=quantum-tutor:latest
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Development-only ownership boundary; use real auth before production.
USER_ACCESS_MODE=development
DEV_USER_IDS=demo-user
# Frontend API base URL. Vite uses this at build time.
VITE_QUANTUM_ENGINE_URL=http://localhost:8000
