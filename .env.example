OLLAMA_URL=http://localhost:11434
# Use quantum-tutor after creating Modelfile.tutor; fall back to granite3.2:8b.
OLLAMA_MODEL=quantum-tutor:latest
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Authentication is enabled in production; use a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-32-character-secret
AUTH_REQUIRED=false
TOKEN_TTL_SECONDS=3600
USER_ACCESS_MODE=development
DEV_USER_IDS=demo-user
# Operational controls
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
# Frontend API base URL. Vite uses this at build time.
VITE_QUANTUM_ENGINE_URL=http://localhost:8000
